include "std/io"

struct Point {
    f64 x;
    f64 y;
}

def test_features(int a, bool flag) -> int {
    defer printf("Deferred 1: Exiting test_features\n");

    if (flag && a > 0) {
        a += 10;
    } else if (a == 0) {
        a -= 5;
    } else {
        a *= 2;
    }

    Point* pt = alloc<Point>();
    defer free(pt);
    defer printf("Deferred 2: Freeing allocated Point\n");

    pt.x = 1.5;
    pt.y = 2.5;

    int sz = sizeof(Point);
    printf("sizeof(Point) = %d bytes\n", sz);
    printf("Point coordinates: (%.1f, %.1f)\n", pt.x, pt.y);

    return a;
}

def main() -> int {
    int res = test_features(10, true);
    printf("test_features(10, true) returned: %d\n", res);
    return 0;
}
